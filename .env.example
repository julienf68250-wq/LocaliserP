# Copie ce fichier en .env (test local), ou place ces variables sur le serveur
# (sur la VM Oracle : ~/LocaliserP/.env, chargé par le service systemd).

# Mot de passe pour accéder au lanceur (choisis-en un solide).
VIEW_PASSWORD=change-moi-vraiment

# Clé de session Flask (génère une longue chaîne aléatoire).
SECRET_KEY=remplace-par-une-longue-chaine-aleatoire

# Liste des parents : "Nom|lien_google|téléphone" séparés par des ';'.
# - lien_google : lien de partage Google Maps « jusqu'à désactivation » (voir GUIDE).
# - téléphone  : optionnel, pour le bouton Appeler.
# Exemple :
PARENTS=Maman|https://maps.app.goo.gl/exemple-maman|+33600000000;Papa|https://maps.app.goo.gl/exemple-papa|+33600000001
