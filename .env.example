# Copie ce fichier en .env (test local), ou place ces variables sur le serveur
# (sur la VM Oracle : ~/LocaliserP/.env, chargé par le service systemd).

# Mot de passe pour consulter la carte (choisis-en un solide).
VIEW_PASSWORD=change-moi-vraiment

# Identifiants OwnTracks de chaque parent : "nom:motdepasse" séparés par des virgules.
# Le "nom" devient le libellé affiché sur la carte (maman -> Maman).
TRACKERS=maman:motdepasse-maman,papa:motdepasse-papa

# Clé de session Flask (génère une longue chaîne aléatoire).
SECRET_KEY=remplace-par-une-longue-chaine-aleatoire

# Optionnel : chemin de la base SQLite (défaut : positions.db).
# DB_PATH=/home/ubuntu/LocaliserP/positions.db

# Broker MQTT pour le bouton "position fraîche" (voie principale).
# Laisse MQTT_HOST vide pour rester en HTTP seul. Avec HiveMQ Cloud (gratuit) :
# MQTT_HOST=xxxxxxxx.s1.eu.hivemq.cloud
# MQTT_PORT=8883
# MQTT_USER=server
# MQTT_PASS=un-mot-de-passe-broker

# Optionnel : alertes Telegram (groupe = tous les enfants).
# TELEGRAM_TOKEN=123456:AA...
# TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# Optionnel : alertes par email (batterie faible, zones).
# Exemple avec Gmail (créer un "mot de passe d'application" dans le compte Google) :
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=toncompte@gmail.com
# SMTP_PASS=le-mot-de-passe-application-16-caracteres
# SMTP_FROM=toncompte@gmail.com
# ALERT_EMAILS=enfant1@mail.com,enfant2@mail.com,enfant3@mail.com
# BATTERY_ALERT=15        # seuil batterie (%)
